DATABASE_HOST=goldentimer-db.cdm2uiqycd2o.ap-northeast-2.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=goldentimer

# 국립중앙의료원 응급의료기관 OpenAPI
ERMCT_SERVICE_KEY=your_service_key
HOSPITAL_SYNC_ENABLED=true
HOSPITAL_SYNC_CYCLE_MINUTES=5
HOSPITAL_SYNC_FULL_HOUR=3

# Google Gemini (transcript analysis, hospital selection, guidance messages)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SEC=30
